# Operation JARVIS — Environment Configuration Example
# Copy this file to .env and configure local parameters.
# Never commit .env or secrets to version control.

# Host & Workspace
JARVIS_WORKSPACE=C:\Users\Akshay aravind .rv\operation_jarvis
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Ollama Local Inference
OLLAMA_API_URL=http://127.0.0.1:11434
PRIMARY_MODEL=qwen-batman:latest
DEFAULT_TEMPERATURE=0.7

# Local Memory Integration
MEMORY_ROOT=C:\Users\Akshay aravind .rv\LOCAL_AI_MEMORY
MEMORY_INDEX_PATH=C:\Users\Akshay aravind .rv\LOCAL_AI_MEMORY\07_MEMORY_INDEX\memory.db

# Security & Audit
POLICY_ENFORCEMENT_MODE=STRICT
AUDIT_LOG_PATH=logs\audit_trail.jsonl

# Weather Service (Open-Meteo is free, no API key required)
DEFAULT_WEATHER_CITY=Bengaluru
DEFAULT_WEATHER_REGION=Karnataka
DEFAULT_WEATHER_COUNTRY=India
DEFAULT_WEATHER_TIMEZONE=Asia/Kolkata
