:root {
  --bg-dark: #080c14;
  --bg-card: #0f172a;
  --bg-surface: #1e293b;
  --accent: #0ea5e9;
  --accent-glow: rgba(14, 165, 233, 0.4);
  --danger: #ef4444;
  --warning: #f59e0b;
  --success: #10b981;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

body, html {
  width: 100%;
  height: 100%;
  background-color: var(--bg-dark);
  color: var(--text-main);
  font-family: var(--font);
  overflow: hidden;
}

.mobile-app {
  display: flex;
  flex-direction: column;
  height: 100vh;
  height: 100dvh;
}

/* Header */
.mobile-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--bg-surface);
  z-index: 10;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.logo {
  width: 32px;
  height: 32px;
  background-color: var(--accent);
  color: #000;
  font-weight: 800;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
}

.brand-text h1 {
  font-size: 16px;
  letter-spacing: 1px;
}

.host-text {
  font-size: 10px;
  color: var(--text-muted);
  font-family: monospace;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.status-dot.online {
  background-color: var(--success);
  box-shadow: 0 0 8px var(--success);
}

.status-dot.offline {
  background-color: var(--danger);
  box-shadow: 0 0 8px var(--danger);
}

.estop-btn {
  background-color: var(--danger);
  color: #fff;
  border: none;
  padding: 4px 10px;
  border-radius: 4px;
  font-weight: 700;
  font-size: 11px;
  cursor: pointer;
}

/* Banner */
.offline-banner {
  background-color: var(--danger);
  color: #fff;
  padding: 8px 12px;
  font-size: 11px;
  text-align: center;
  font-weight: 600;
}

.approvals-banner {
  background-color: rgba(245, 158, 11, 0.2);
  border: 1px solid var(--warning);
  color: var(--warning);
  padding: 8px 12px;
  margin: 8px 12px 0;
  border-radius: 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
}

.approvals-banner button {
  background-color: var(--warning);
  color: #000;
  border: none;
  padding: 3px 8px;
  border-radius: 4px;
  font-weight: 600;
  font-size: 11px;
}

/* Main Container */
.main-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Chat Feed */
.chat-feed {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  -webkit-overflow-scrolling: touch;
}

.chat-msg {
  display: flex;
  flex-direction: column;
  max-width: 82%;
  gap: 4px;
}

.jarvis-msg {
  align-self: flex-start;
}

.jarvis-msg .msg-bubble {
  background-color: var(--bg-card);
  border-left: 3px solid var(--accent);
  color: var(--text-main);
  border-radius: 4px 12px 12px 4px;
  padding: 12px 14px;
  font-size: 14px;
  line-height: 1.4;
}

.user-msg {
  align-self: flex-end;
}

.user-msg .msg-bubble {
  background-color: #0369a1;
  color: #fff;
  border-radius: 12px 4px 12px 12px;
  padding: 12px 14px;
  font-size: 14px;
  line-height: 1.4;
}

.msg-time {
  font-size: 10px;
  color: var(--text-muted);
  font-family: monospace;
}

/* Voice Footer */
.voice-footer {
  background-color: var(--bg-card);
  border-top: 1px solid var(--bg-surface);
  padding: 16px 16px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.ptt-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.ptt-btn {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  background: radial-gradient(circle, #0284c7 0%, #0369a1 100%);
  border: 3px solid var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 15px var(--accent-glow);
  cursor: pointer;
  transition: all 0.15s ease;
  touch-action: none;
}

.ptt-btn:active, .ptt-btn.active {
  transform: scale(0.92);
  background: radial-gradient(circle, #ef4444 0%, #dc2626 100%);
  border-color: #fca5a5;
  box-shadow: 0 0 25px rgba(239, 68, 68, 0.7);
}

.mic-icon {
  width: 34px;
  height: 34px;
}

.ptt-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 1px;
}

.text-fallback-row {
  width: 100%;
  display: flex;
  gap: 8px;
}

.text-fallback-row input {
  flex: 1;
  background-color: var(--bg-dark);
  border: 1px solid var(--bg-surface);
  color: #fff;
  padding: 8px 12px;
  border-radius: 6px;
  font-size: 13px;
  user-select: text;
  -webkit-user-select: text;
}

.btn-send {
  background-color: var(--bg-surface);
  color: var(--accent);
  border: 1px solid var(--accent);
  padding: 8px 14px;
  border-radius: 6px;
  font-weight: 600;
  font-size: 12px;
}

/* Pairing Screen */
.pairing-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.pairing-card {
  background-color: var(--bg-card);
  border: 1px solid var(--bg-surface);
  padding: 24px;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  width: 100%;
  max-width: 360px;
}

.pairing-card h2 {
  font-size: 16px;
  color: var(--accent);
}

.pairing-card p {
  font-size: 13px;
  color: var(--text-muted);
}

.pairing-card input {
  background-color: var(--bg-dark);
  border: 1px solid var(--bg-surface);
  color: #fff;
  padding: 10px;
  border-radius: 4px;
  font-size: 14px;
  user-select: text;
  -webkit-user-select: text;
}

.btn-primary {
  background-color: var(--accent);
  color: #000;
  border: none;
  padding: 10px;
  border-radius: 4px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
}

/* Modal */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.modal-content {
  background-color: var(--bg-card);
  border-top: 1px solid var(--bg-surface);
  width: 100%;
  max-height: 80vh;
  border-radius: 16px 16px 0 0;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-close {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 24px;
  cursor: pointer;
}
