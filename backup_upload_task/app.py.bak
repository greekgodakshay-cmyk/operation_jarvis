@app.post("/api/v1/email/send")
def api_send_email(req: SendEmailRequest):
    from registry.email_adapter import email_adapter
    try:
        return email_adapter.send_email(
            recipient=req.recipient,
            subject=req.subject,
            body=req.body,
            draft_id=req.draft_id,
            approval_token=req.approval_token
        )
    except ApprovalRequiredError as are:
        raise HTTPException(
            status_code=403,
            detail={
                "message": "Sending email is a Level 3 Restricted action requiring explicit user approval.",
                "approval_request": are.approval_request.dict()
            }
        )

