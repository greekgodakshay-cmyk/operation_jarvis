@app.post("/api/v1/calendar/events/{event_id}/cancel")
def api_cancel_calendar_event(event_id: str, req: CancelCalendarEventRequest):
    from registry.calendar_adapter import calendar_adapter
    try:
        res = calendar_adapter.cancel_event(event_id=event_id, approval_token=req.approval_token)
        if not res.get("ok"):
            raise HTTPException(status_code=400, detail=res.get("error"))
        return res
    except ApprovalRequiredError as are:
        raise HTTPException(
            status_code=403,
            detail={
                "message": "Cancelling calendar event is a Level 3 Restricted action requiring explicit user approval.",
                "approval_request": are.approval_request.dict()
            }
        )

