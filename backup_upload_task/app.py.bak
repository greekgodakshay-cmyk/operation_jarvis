# --- Security & Emergency Stop Endpoints ---

class EmergencyStopRequest(BaseModel):
    action: str = Field(..., description="'trigger' or 'reset'")
    reason: Optional[str] = "Manual operator intervention from Dashboard"

@app.post("/api/v1/security/emergency_stop")
def api_emergency_stop(req: EmergencyStopRequest):
    if req.action.lower() == "trigger":
        policy_engine.trigger_emergency_stop()
        return {"ok": True, "emergency_stopped": True, "message": f"Emergency stop triggered: {req.reason}"}
    elif req.action.lower() == "reset":
        policy_engine.reset_emergency_stop()
        return {"ok": True, "emergency_stopped": False, "message": "Emergency stop reset. System online."}
    else:
        raise HTTPException(status_code=400, detail="Invalid action. Must be 'trigger' or 'reset'.")

# --- Unified Local Dashboard Summary Endpoint ---

@app.get("/api/v1/dashboard/summary")
def api_dashboard_summary():
    """Aggregated status payload for the unified local dashboard."""
    # 1. System stats
    ram = psutil.virtual_memory()
    system_stats = {
        "platform": "Windows 11 Home 64-bit",
        "workstation": "HP Victus 15-fa2382TX",
        "cpu": "Intel Core 5 210H (12 Logical Cores)",
        "cpu_percent": psutil.cpu_percent(interval=None),
        "ram_used_gb": round((ram.total - ram.available) / (1024**3), 2),
        "ram_total_gb": round(ram.total / (1024**3), 2),
        "ram_percent": ram.percent,
        "gpu": "NVIDIA GeForce RTX 4050 6GB Laptop GPU",
        "vram_allocated_gb": 4.3,
        "vram_total_gb": 6.0
    }

    # 2. LLM and Models
    from core.model_router import model_router
    ollama_ok = llm_client.is_healthy()
    llm_stats = {
        "ollama_endpoint": settings.ollama_api_url,
        "ollama_healthy": ollama_ok,
        "active_models": [
            {"id": "qwen-batman:latest", "role": "Batman Persona & Local Coworker", "tier": "local_qwen_batman", "status": "resident"},
            {"id": "qwen-text:latest", "role": "General & Technical Text Tasks", "tier": "local_qwen_text", "status": "available"},
            {"id": "qwen3.5:9b", "role": "General Assistant Engine", "tier": "local_qwen_assistant", "status": "available"}
        ],
        "usage": model_router.usage_tracker.get_summary()
    }

    # 3. Agents
    agent_tool = capability_registry.get_tool("agent_list")
    agents_data = agent_tool.handler() if agent_tool else {"agents": []}

    # 4. Capability Registry
    all_tools = capability_registry.list_tools()
    tools_by_level = {"LEVEL_1_SAFE": 0, "LEVEL_2_CONTROLLED": 0, "LEVEL_3_RESTRICTED": 0}
    for t in all_tools:
        lvl = t.get("permission_level", "LEVEL_1_SAFE")
        tools_by_level[lvl] = tools_by_level.get(lvl, 0) + 1

    # 5. Persistent Schedules
    from core.scheduler import persistent_scheduler
    schedules = persistent_scheduler.list_schedules()

    # 6. Memory & Documents
    from core.doc_intelligence import doc_intelligence
    docs = doc_intelligence.list_documents()
    total_chunks = sum(d.get("total_chunks", 0) for d in docs)
    memory_count = memory_adapter.get_status().get("total_records", 1101)

    # 7. Email & Calendar
    from registry.email_adapter import email_adapter
    from registry.calendar_adapter import calendar_adapter
    emails = email_adapter.search_emails(query="", limit=5)
    events = calendar_adapter.get_events()

    # 8. Security & Pending Approvals
    pending_tasks = task_db.list_tasks(status=TaskStatus.WAITING_FOR_APPROVAL)
    recent_tasks = task_db.list_tasks(limit=10)

    is_stopped = policy_engine.is_emergency_stopped()
    overall_status = "emergency_stopped" if is_stopped else ("online" if ollama_ok else "degraded")

    return {
        "status": overall_status,
        "emergency_stopped": is_stopped,
        "timestamp": time.time(),
        "system": system_stats,
        "llm": llm_stats,
        "agents": agents_data.get("agents", []),
        "capabilities": {
            "total_tools": len(all_tools),
            "by_level": tools_by_level,
            "tools": all_tools
        },
        "schedules": {
            "total": len(schedules),
            "items": schedules
        },
        "knowledge": {
            "memory_nodes": memory_count,
            "indexed_documents": len(docs),
            "indexed_chunks": total_chunks,
            "documents": docs
        },
        "communications": {
            "email_connected": True,
            "total_emails": len(email_adapter.search_emails(limit=100)),
            "recent_emails": emails,
            "calendar_connected": True,
            "total_events": len(events),
            "upcoming_events": events[:5]
        },
        "security": {
            "pending_approvals": len(pending_tasks),
            "pending_tasks": [
                {"task_id": t.task_id, "objective": t.objective, "created_at": t.created_at}
                for t in pending_tasks
            ],
            "recent_tasks": [
                {"task_id": t.task_id, "objective": t.objective, "status": t.status.value, "created_at": t.created_at}
                for t in recent_tasks
            ]
        }
    }

